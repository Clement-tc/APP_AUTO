{
    "id": null,
    "title": "Offre API - Pod Detail",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "timezone": "browser",
    "panels": [
      {
        "type": "timeseries",
        "title": "⏱️ Delay HTTP (flask_http_request_duration_seconds)",
        "targets": [
          {
            "expr": "rate(flask_http_request_duration_seconds_sum{pod=\"offre-api-7b899d8644-c549l\"}[1m]) / rate(flask_http_request_duration_seconds_count{pod=\"offre-api-7b899d8644-c549l\"}[1m])",
            "legendFormat": "Latency avg",
            "refId": "A"
          }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 0, "w": 24, "h": 6 }
      },
      {
        "type": "timeseries",
        "title": "🔥 CPU Usage - offre-api-7b899d8644-c549l",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{pod=\"offre-api-7b899d8644-c549l\"}[5m])",
            "legendFormat": "CPU",
            "refId": "B"
          }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 6, "w": 12, "h": 6 }
      },
      {
        "type": "timeseries",
        "title": "💾 Memory Usage - offre-api-7b899d8644-c549l",
        "targets": [
          {
            "expr": "container_memory_usage_bytes{pod=\"offre-api-7b899d8644-c549l\"}",
            "legendFormat": "Memory",
            "refId": "C"
          }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 12, "y": 6, "w": 12, "h": 6 }
      },
      {
        "type": "timeseries",
        "title": "📊 CPU Requests vs Limits - offre-api-7b899d8644-c549l",
        "targets": [
          {
            "expr": "kube_pod_container_resource_requests_cpu_cores{pod=\"offre-api-7b899d8644-c549l\"}",
            "legendFormat": "Request CPU",
            "refId": "D"
          },
          {
            "expr": "kube_pod_container_resource_limits_cpu_cores{pod=\"offre-api-7b899d8644-c549l\"}",
            "legendFormat": "Limit CPU",
            "refId": "E"
          }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 }
      },
      {
        "type": "timeseries",
        "title": "📊 Memory Requests vs Limits - offre-api-7b899d8644-c549l",
        "targets": [
          {
            "expr": "kube_pod_container_resource_requests_memory_bytes{pod=\"offre-api-7b899d8644-c549l\"}",
            "legendFormat": "Request RAM",
            "refId": "F"
          },
          {
            "expr": "kube_pod_container_resource_limits_memory_bytes{pod=\"offre-api-7b899d8644-c549l\"}",
            "legendFormat": "Limit RAM",
            "refId": "G"
          }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 }
      },
      {
        "type": "timeseries",
        "title": "🐘 CPU PostgreSQL",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{pod=~\"postgres.*\"}[5m])",
            "legendFormat": "{{pod}}",
            "refId": "H"
          }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 18, "w": 12, "h": 6 }
      },
      {
        "type": "timeseries",
        "title": "🐘 Memory PostgreSQL",
        "targets": [
          {
            "expr": "container_memory_usage_bytes{pod=~\"postgres.*\"}",
            "legendFormat": "{{pod}}",
            "refId": "I"
          }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 12, "y": 18, "w": 12, "h": 6 }
      },
      {
        "type": "timeseries",
        "title": "🧠 CPU pgAdmin",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{pod=~\"pgadmin.*\"}[5m])",
            "legendFormat": "{{pod}}",
            "refId": "J"
          }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 24, "w": 12, "h": 6 }
      },
      {
        "type": "timeseries",
        "title": "🧠 Memory pgAdmin",
        "targets": [
          {
            "expr": "container_memory_usage_bytes{pod=~\"pgadmin.*\"}",
            "legendFormat": "{{pod}}",
            "refId": "K"
          }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 12, "y": 24, "w": 12, "h": 6 }
      }
    ]
  }
  